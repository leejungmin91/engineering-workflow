{
  "description": "Engineering Workflow hooks check Git approvals and scan commits for secrets. Codex stores the approved actions for each turn.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/run.sh\" guard_git",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/run.sh\" record_prompt",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
