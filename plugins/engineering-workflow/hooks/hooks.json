{
  "description": "Engineering Workflow hooks commit and push the work left in the repository when the assistant finishes a turn.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/auto_commit_push.sh\"",
            "timeout": 120,
            "statusMessage": "Committing and pushing changes..."
          }
        ]
      }
    ]
  }
}
